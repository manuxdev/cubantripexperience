---
import Layout from "@layouts/Layout.astro";
import { primaryNavigation } from "../data/routes";
---

<Layout
  title="Page not found"
  description="The page you were looking for is not available.">
  <section class="page-container flex min-h-[50vh] flex-col justify-center py-section">
    <p class="text-6xl font-bold text-gold">404</p>
    <h1 class="mt-4 text-4xl font-bold md:text-5xl">Page not found</h1>
    <p class="prose-width mt-4 text-lg text-ink/80">
      The page you were looking for is not available. Try one of these instead:
    </p>
    <ul class="mt-6 flex flex-wrap gap-4">
      <li>
        <a href="/" class="font-semibold underline underline-offset-4 hover:text-gold">
          Home
        </a>
      </li>
      {
        primaryNavigation.map((item) => (
          <li>
            <a
              href={item.href}
              class="font-semibold underline underline-offset-4 hover:text-gold">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
