---
import HomePage from "../components/es/HomePage.astro";
---

{/* English drops both empty sections and marks the band above the van block
    `hide_mobile` instead. Its footer authors no tablet override, so the logo
    column and the menu keep their desktop widths. */}
<HomePage
  lang="en"
  footerMenuTabletWidth="311.312px"
  footerLogoTabletWidth="9.208%"
  gapSection="none"
  emptyMobileSection={false}
  blueBandHiddenOnMobile={true}
  footerNarrowGap={true}
/>
