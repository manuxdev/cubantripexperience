---
import EsLayout from "../../layouts/EsLayout.astro";
import { SERVICES } from "../../data/services";
import { ROUTES } from "../../i18n/site";
import type { SiteLang } from "../../i18n/site";
import standardImg from "@assets/pages/services/standard.webp";
import vanImg from "@assets/pages/services/van.webp";
import classicImg from "@assets/pages/services/classic.webp";
import discoverBg from "@assets/pages/es/discover-destinations.webp";
import discoverBgMobile from "@assets/pages/es/discover-destinations-mobile.webp";

// reference/es/servicios/spec.md — Sections 3-10. Section 1 (hero), Section 2
// (nav) and Section 11 (footer) are the shared `EsLayout` shell.
//
// The three "Estándar/Van/Clásico" selector buttons (Section 3) carry
// `data-show`/`data-showme` custom attributes (only in `elementor.json`, not
// `spec.md`) that toggle a matching icon-box/image pair via a global
// `.all-data,.all-images{display:none}` rule with per-target ID overrides
// (`#data-estandar{display:block}`, `#estandar{display:block}`) — confirmed
// live against the source's inline `<style>`. Default first-load state (what
// `desktop.png`/`tablet.png`/`mobile.png` capture) shows only "Estándar"; Van
// and Clásico are `display:none` until a click that never happens during a
// screenshot. Reproduced the same way: `hidden` on the Van/Clásico panels,
// no click handler (visual-only, same "static snapshot" pattern as
// `reservar`'s tabs — proposal.md Non-goals covers no interactive booking
// logic, and this selector carries none either way).
//
// Icon-box geometry (circle bg #F8F43D, icon 38px/16px padding = 70px circle,
// title 26px/31.2px #272722, description 16px/25.6px #000) measured live via
// `reference/tools/typo.mjs` — the widget's own CSS variables aren't in
// `_elementor_data`, only in Elementor's per-post generated stylesheet.
// `fa-bus-alt` has no FA6 free-solid glyph (renamed `fa-van-shuttle`); used
// that glyph, a visually equivalent shuttle icon, since the FA5 name is gone
// upstream and this project ships no icon font.
export interface Props {
  lang?: SiteLang;
}

const { lang = "es" } = Astro.props;
const c = SERVICES[lang];

const vehicles = [
  {
    id: "estandar",
    tabPaddingMobile: "10px 3px 10px 0px",
    icon: "bolt",
    viewBox: "0 0 448 512",
    path: "M349.4 44.6c5.9-13.7 1.5-29.7-10.6-38.5s-28.6-8-39.9 1.8l-256 224c-10 8.8-13.6 22.9-8.9 35.3S50.7 288 64 288l111.5 0L98.6 467.4c-5.9 13.7-1.5 29.7 10.6 38.5s28.6 8 39.9-1.8l256-224c10-8.8 13.6-22.9 8.9-35.3s-16.6-20.7-30-20.7l-111.5 0L349.4 44.6z",
    image: standardImg,
    imageMarginMobile: "-58px",
  },
  {
    id: "vans",
    tabPaddingMobile: "10px 20px 10px 20px",
    icon: "van-shuttle",
    viewBox: "0 0 640 512",
    path: "M64 104l0 88 96 0 0-96L72 96c-4.4 0-8 3.6-8 8zm482 88L465.1 96 384 96l0 96 162 0zm-226 0l0-96-96 0 0 96 96 0zM592 384l-16 0c0 53-43 96-96 96s-96-43-96-96l-128 0c0 53-43 96-96 96s-96-43-96-96l-16 0c-26.5 0-48-21.5-48-48L0 104C0 64.2 32.2 32 72 32l120 0 160 0 113.1 0c18.9 0 36.8 8.3 49 22.8L625 186.5c9.7 11.5 15 26.1 15 41.2L640 336c0 26.5-21.5 48-48 48zm-64 0a48 48 0 1 0 -96 0 48 48 0 1 0 96 0zM160 432a48 48 0 1 0 0-96 48 48 0 1 0 0 96z",
    image: vanImg,
    imageMarginMobile: "-30px",
  },
  {
    id: "clasico",
    tabPaddingMobile: "10px 10px 10px 10px",
    icon: "star",
    viewBox: "0 0 576 512",
    path: "M316.9 18C311.6 7 300.4 0 288.1 0s-23.4 7-28.8 18L195 150.3 51.4 171.5c-12 1.8-22 10.2-25.7 21.7s-.7 24.2 7.9 32.7L137.8 329 113.2 474.7c-2 12 3 24.2 12.9 31.3s23 8 33.8 2.3l128.3-68.5 128.3 68.5c10.8 5.7 23.9 4.9 33.8-2.3s14.9-19.3 12.9-31.3L438.5 329 542.7 225.9c8.6-8.5 11.7-21.2 7.9-32.7s-13.7-19.9-25.7-21.7L381.2 150.3 316.9 18z",
    image: classicImg,
    imageMarginMobile: "-71px",
  },
] as const;
---

<EsLayout
  title={c.title}
  heroTitle={c.hero}
  showReserve={true}
  lang={lang}>
  {/* Section 3 */}
  <section
    class="bg-[linear-gradient(#E3F4F570_43%,#67B3E8_100%)]">
    <div class="mx-auto max-w-[1140px] p-[10px]">
      <div class="h-[27px] mb-[20px]" aria-hidden="true"></div>

      <div class="p-[10px]">
        <h2
          class="text-center font-poppins text-[38px] font-semibold leading-[47.5px] text-black mobile:text-[31px] mobile:leading-[38.75px]">
          {c.vehiclesHeading}
        </h2>
      </div>

      <div class="mx-auto flex max-w-[500px] items-center justify-around py-[5px]">
        {
          vehicles.map((v, i) => (
            <button
              type="button"
              data-vehicle={v.id}
              aria-pressed={v.id === vehicles[0].id ? "true" : "false"}
              class="es-vh-tab rounded-[7px] border border-es-brand font-poppins mobile:border-[3px] text-[15px] font-medium leading-[15px] text-black hover:bg-[#F8F43DED]"
              style={`--tab-pad-mobile:${v.tabPaddingMobile}`}>
              {c.tabs[i]}
            </button>
          ))
        }
      </div>

      {/* Elementor sets `background_color`/`background_color_b` here but never
          sets `background_background`, so the nested section stays
          transparent and the outer Section 3 blue gradient shows through —
          confirmed live (`getComputedStyle` reports `background-color:
          rgba(0,0,0,0)`), not a rendering bug. */}
      <div>
        <div class="flex flex-wrap items-start mobile:flex-col">
          <div class="mt-[20px] basis-1/2 p-[10px] text-center mobile:basis-full">
            {
              vehicles.map((v, i) => (
                <div
                  id={`data-${v.id}`}
                  class:list={["mb-[20px]", i !== 0 && "hidden"]}>
                  {/* `.elementor-icon-box-icon` is a line box with the circle
                      sitting on its baseline, so it measures the icon plus the
                      strut's descent (77.59px desktop, 76.34px tablet, 69.34px
                      mobile) and carries a 5px bottom margin — not a flat 13px
                      gap. `leading-[1.6rem]` because Tailwind's preflight ships
                      `html { line-height: 1.5 }` after `es.css`. */}
                  <div class="mb-[5px] text-center leading-[1.6rem]">
                    {/* `inline-block`, not `inline-flex`: with a block-level SVG inside there
                        is no in-flow line box, so the baseline falls on the bottom
                        margin edge and the wrapper line box becomes icon + strut
                        descent. `inline-flex` borrows the SVG's own baseline and the
                        line box collapses to the icon height. The 16px padding
                        centres the glyph exactly (70-32=38, 63-32=31). */}
                    <span class="inline-block h-[70px] w-[70px] rounded-full bg-es-brand p-[16px] mobile:h-[63px] mobile:w-[63px]">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox={v.viewBox}
                        class="block h-[38px] w-[38px] text-white mobile:h-[31px] mobile:w-[31px]"
                        fill="currentColor"
                        aria-hidden="true">
                        <path d={v.path} />
                      </svg>
                    </span>
                  </div>
                  {/* Astra's responsive h3: 26px/31.2px desktop, 20px/24px at
                      tablet and mobile. */}
                  <h3 class="mb-[20px] font-poppins text-[26px] font-semibold leading-[31.2px] text-[#272722] tablet:text-[20px] tablet:leading-[24px]">
                    {c.vehicles[i].title}
                  </h3>
                  <p class="font-poppins text-[16px] leading-[25.6px] text-black tablet:text-[14.592px] tablet:leading-[23.3472px] mobile:text-[13px] mobile:leading-[23.3472px]">
                    {c.vehicles[i].description}
                  </p>
                </div>
              ))
            }
          </div>
          <div class="basis-1/2 p-[10px] mobile:basis-full">
            {
              vehicles.map((v, i) => (
                <div
                  id={v.id}
                  data-anim="fadeInRight"
                  class:list={["mb-[20px]", i !== 0 && "hidden"]}
                  style={`--img-mt-mobile: ${v.imageMarginMobile}`}>
                  <img
                    src={v.image.src}
                    width={v.image.width}
                    height={v.image.height}
                    alt={v.title}
                    class="mx-auto h-auto max-w-full mobile:mt-[var(--img-mt-mobile)]" />
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="h-[35px] mobile:h-[102px]" aria-hidden="true"></div>
    </div>
  </section>

  {/* Section 4 */}
  <div class="mx-auto max-w-[1140px] p-[10px]">
    <div class="h-[23px]" aria-hidden="true"></div>
  </div>

  {/* Section 5. Spec carries `background_color`/`background_color_b` on both
      the section and its column, but neither sets `background_background`,
      so both stay transparent — confirmed live and against `desktop.png`
      (pure white, not `#BEBCBC`/`#F0E9E9`). Same dead-setting pattern as the
      icon-box/image nested section above.

      Neither widget carries `_element_width_mobile`, so — unlike the
      `_element_width_mobile=inherit` case — the custom width percentages
      stay active at every breakpoint: measured live, the heading keeps
      wrapping inside its narrow 63.968% column down to 390px instead of
      stacking full-width, so no `mobile:` override here. */}
  <section>
    <div class="mx-auto flex max-w-[1140px] items-center justify-around p-[10px]">
      <h2 class="basis-[63.968%] p-[30px] text-left font-poppins text-[32px] font-semibold leading-[40px] text-[#3A3A3A] tablet:text-[25px] tablet:leading-[31.25px]">
        {c.ctaHeading}
      </h2>
      {/* `min-w-0` so the authored 33.701% holds: the Russian label is wider
          than the box and must wrap inside it, as it does in the source, rather
          than stretching the item to its content. */}
      <div class="flex min-w-0 basis-[33.701%] justify-center">
        <a
          href={ROUTES[lang].booking}
          class="rounded-[3px] bg-[#F8F43DDB] px-[20px] py-[15px] text-center font-poppins text-[15px] font-medium leading-[15px] text-[#202020] hover:bg-[#F8F43D8C]">
          {c.ctaButton}
        </a>
      </div>
    </div>
  </section>

  {/* Section 6 */}
  <div class="mx-auto max-w-[1140px] p-[10px]">
    <div class="h-[10px] mb-[20px]" aria-hidden="true"></div>
    <h2 class="text-center font-poppins text-[32px] font-semibold leading-[40px] text-[#F7CF1A] tablet:text-[25px] tablet:leading-[31.25px]">
      {c.proHeading}
    </h2>
  </div>

  {/* Section 7 — a 100% column holding an inner section of two 50% columns,
      so the copy is inset twice: 10px of outer wrap padding plus 10px of the
      inner column's, which is what puts the widgets at x170/x730 rather than
      x160/x720. The three blocks are three separate `text-editor` widgets, not
      paragraphs: their gap is Elementor's 20px inter-widget margin and the last
      widget in a wrap has none — a `<p>` rhythm would add 25.6px between them
      and another 25.6px of trailing margin. The source has no `<p>` at all. */}
  <div class="mx-auto max-w-[1140px] p-[10px]">
    <div class="flex mobile:flex-col">
      <div class="basis-1/2 p-[10px] mobile:basis-auto">
        {
          c.paragraphs.slice(0, 2).map((text, i) => (
            <div class:list={["es-copy", i === 0 ? "mb-[20px]" : ""]}>{text}</div>
          ))
        }
      </div>
      <div class="basis-1/2 p-[10px] mobile:basis-auto">
        {
          c.paragraphs.slice(2).map((text, i) => (
            <div class:list={["es-copy", i === 0 ? "" : "mt-[20px]"]}>{text}</div>
          ))
        }
      </div>
    </div>
  </div>

  {/* Section 8 */}
  <div class="mx-auto max-w-[1140px] p-[10px]">
    <div class="h-[19px] mobile:h-[32px]" aria-hidden="true"></div>
  </div>

  {/* Section 9 */}
  <section
    class="relative flex min-h-[292px] items-center justify-center bg-[length:100%_auto] bg-[position:0px_-96px] bg-no-repeat tablet:bg-[position:0px_0px] mobile:min-h-[216px]"
    style={`background-image: url(${discoverBg.src})`}>
    <div class="absolute inset-0 hidden bg-[position:center] bg-cover bg-no-repeat mobile:block" style={`background-image: url(${discoverBgMobile.src})`}></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,#FCFCFC_5%,#0C0205_100%)] opacity-50"></div>
    <div class="relative z-10 p-[10px] text-center">
      <h2 class="font-poppins text-[34px] font-bold leading-[42.5px] text-black mobile:text-[23px] mobile:leading-[28.75px]">
        {c.discoverHeading}
      </h2>
      <a
        href={ROUTES[lang].destinations}
        class="mt-[10px] inline-flex items-center gap-[6px] font-poppins text-[20px] font-medium leading-[20px] text-white hover:text-[#E1E22F] mobile:text-[16px] mobile:leading-[16px]">
        {c.discoverButton}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 512 512"
          class="h-[18px] w-[18px]"
          fill="currentColor"
          aria-hidden="true">
          <path
            d="M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zM207 151c9.4-9.4 24.6-9.4 33.9 0l104 104c9.4 9.4 9.4 24.6 0 33.9L241 393c-9.4 9.4-24.6 9.4-33.9 0s-9.4-24.6 0-33.9l71-71-71-71c-9.4-9.4-9.4-24.6 0-33.9z"
          ></path>
        </svg>
      </a>
    </div>
  </section>

  {/* Section 10 */}
  <div class="mx-auto max-w-[1140px] p-[10px]">
    <div class="h-[94px]" aria-hidden="true"></div>
  </div>
</EsLayout>


<script>
  // The source's selector buttons carry `data-show`/`data-showme` attributes and
  // toggle the matching icon-box/image pair through a global
  // `.all-data,.all-images{display:none}` rule with per-target ID overrides.
  // Same behaviour, without the ID-selector gymnastics: `hidden` on the panels
  // the button does not own. Estándar is the first-load state, which is what
  // every reference capture is in.
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-vehicle]")];
  if (buttons.length) {
    // The filled state is applied only once the visitor actually picks a
    // vehicle. The source paints no active tab on load, and every reference
    // capture is the load state, so highlighting Estándar up front would move
    // the pixel gate on all three viewports.
    const select = (id: string) => {
      for (const button of buttons) {
        const active = button.dataset.vehicle === id;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("bg-[#F8F43DED]", active);
      }
      for (const button of buttons) {
        const key = button.dataset.vehicle!;
        document.getElementById(`data-${key}`)?.classList.toggle("hidden", key !== id);
        document.getElementById(key)?.classList.toggle("hidden", key !== id);
      }
    };
    for (const button of buttons) {
      button.addEventListener("click", () => select(button.dataset.vehicle!));
    }
  }
</script>

<style>
  /* Driven from the custom property at BOTH breakpoints: Astro compiles
     scoped selectors to `.es-vh-tab:where(.astro-xxxx)`, zero-specificity inside
     `:where()`, so it cannot outrank a Tailwind `px-*` class on the same
     element. */
  .es-vh-tab {
    padding: 12px 24px;
  }

  /* `text_padding_mobile` differs per tab: `10 3 10 0`, `10 20 10 20`,
     `10 10 10 10`. The 10px gap between them is `_margin_tablet` right. */
  @media (min-width: 768px) and (max-width: 1024px) {
    .es-vh-tab {
      margin-right: 10px;
    }
  }



  @media (max-width: 767px) {
    .es-vh-tab {
      padding: var(--tab-pad-mobile);
    }
  }
</style>
