---
import footerMark from "@assets/brand/cuban-trip-experience-mark.webp";
import { STRINGS, footerLinks } from "../../i18n/site";
import type { SiteLang } from "../../i18n/site";

// Last section on every Spanish page. Identical except
// `_element_custom_width_tablet` (`223.328px`, `331px` on `inicio`).
export interface Props {
  menuTabletWidth?: string;
  /**
   * The source authors this line per page, not once. Three casings exist:
   * "Derechos Reservados" (most pages), "derechos Reservados" (`matanzas`)
   * and "derechos reservados" (`reservar`).
   */
  copyright?: string;
  /**
   * The logo column's `_inline_size_tablet`: `35%` on ten pages, `9%` on
   * `inicio`. It is the whole footer layout at tablet — at 35% the middle
   * column no longer fits beside it and the three columns wrap into a stack.
   */
  logoTabletWidth?: string;
  lang?: SiteLang;
  dropBookingsLink?: boolean;
  /**
   * The English home is the one page whose footer is a different Elementor
   * template: its container is `elementor-column-gap-narrow`, so every column
   * wraps its widgets in 5px instead of 10px and the logo renders 10px wider.
   */
  narrowGap?: boolean;
}

const {
  menuTabletWidth = "223.328px",
  copyright,
  logoTabletWidth = "35%",
  lang = "es",
  dropBookingsLink = false,
  narrowGap = false,
} = Astro.props;
const pad = narrowGap ? "p-[5px]" : "p-[10px]";
const t = STRINGS[lang];
const links = footerLinks(lang, dropBookingsLink);

const socialLinks = [
  { label: "Correo", href: "mailto:cubantripexperience@gmail.com" },
  {
    label: "Facebook",
    href: "https://www.facebook.com/profile.php?id=61551441593993",
  },
  { label: "Instagram", href: "https://www.instagram.com/cubantripexperience/" },
  { label: "WhatsApp", href: "https://wa.me/+5353788250/" },
] as const;

// Font Awesome source view boxes differ per icon (`fa-envelope` is 512 wide,
// the brand marks are 448).
const socialIconViewBox: Record<string, string> = {
  Correo: "0 0 512 512",
  Facebook: "0 0 448 512",
  Instagram: "0 0 448 512",
  WhatsApp: "0 0 448 512",
};

const socialIconPaths: Record<string, string> = {
  Correo:
    "M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48H48zM0 176V384c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V176L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z",
  Facebook:
    "M400 32H48A48 48 0 0 0 0 80v352a48 48 0 0 0 48 48h137.25V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.27c-30.81 0-40.42 19.12-40.42 38.73V256h68.78l-11 71.69h-57.78V480H400a48 48 0 0 0 48-48V80a48 48 0 0 0-48-48z",
  Instagram:
    "M224,202.66A53.34,53.34,0,1,0,277.36,256,53.38,53.38,0,0,0,224,202.66Zm124.71-41a54,54,0,0,0-30.41-30.41c-21-8.29-71-6.43-94.3-6.43s-73.25-1.93-94.31,6.43a54,54,0,0,0-30.41,30.41c-8.28,21-6.43,71.05-6.43,94.33S91,329.26,99.32,350.33a54,54,0,0,0,30.41,30.41c21,8.29,71,6.43,94.31,6.43s73.24,1.93,94.3-6.43a54,54,0,0,0,30.41-30.41c8.35-21,6.43-71.05,6.43-94.33S357.1,182.74,348.75,161.67ZM224,338a82,82,0,1,1,82-82A81.9,81.9,0,0,1,224,338Zm85.38-148.3a19.14,19.14,0,1,1,19.13-19.14A19.1,19.1,0,0,1,309.42,189.74ZM400,32H48A48,48,0,0,0,0,80V432a48,48,0,0,0,48,48H400a48,48,0,0,0,48-48V80A48,48,0,0,0,400,32ZM382.88,322c-1.29,25.63-7.14,48.34-25.85,67s-41.4,24.63-67,25.85c-26.41,1.49-105.59,1.49-132,0-25.63-1.29-48.26-7.15-67-25.85s-24.63-41.42-25.85-67c-1.49-26.42-1.49-105.61,0-132,1.29-25.63,7.07-48.34,25.85-67s41.47-24.56,67-25.78c26.41-1.49,105.59-1.49,132,0,25.63,1.29,48.33,7.15,67,25.85s24.63,41.42,25.85,67.05C384.37,216.44,384.37,295.56,382.88,322Z",
  WhatsApp:
    "M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z",
};
---

<footer class="bg-[#F2EDED]">
  <div class="mx-auto flex max-w-[1140px] flex-wrap">
    <div
      class:list={["flex w-[9.208%] items-center mobile:w-[20%] tablet:w-[var(--es-footer-logo-tablet)]", pad]}
      style={`--es-footer-logo-tablet: ${logoTabletWidth}`}>
      <img
        src={footerMark.src}
        width={footerMark.width}
        height={footerMark.height}
        alt=""
        class="h-auto w-full" />
    </div>

    <div
      class:list={["flex w-[57.124%] flex-col justify-center mobile:w-[80%]", pad]}>
      <p
        class="mb-[7px] font-poppins text-[12px] font-normal leading-[12px] text-[#414141]">
        &copy; 2023 CubanTripExperience | {copyright ?? t.copyright}
      </p>
      <nav aria-label={t.footerMenuLabel} class="w-auto" style={`--es-footer-menu-tablet: ${menuTabletWidth}`}>
        <ul
          class="flex flex-wrap font-poppins tablet:w-[var(--es-footer-menu-tablet)] mobile:w-[263.118px]">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="block px-[7px] py-[1px] text-[17px] font-semibold leading-[17px] text-[#313131] underline hover:text-[#5F5E5C] mobile:py-[6px] mobile:text-[13px] mobile:leading-[13px]">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div
      class:list={["flex w-[33.333%] items-center justify-center mobile:w-full mobile:justify-start mobile:pl-[20px]", pad]}>
      <ul class="flex items-center gap-[16px]" aria-label="Redes sociales">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                aria-label={link.label}
                class="es-hover-pulse flex h-[38px] w-[38px] items-center justify-center text-[#F5E234] hover:text-[#DFCB13] tablet:h-[28px] tablet:w-[28px] mobile:h-[31px] mobile:w-[31px]">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox={socialIconViewBox[link.label]}
                  class="h-full w-full"
                  fill="currentColor"
                  aria-hidden="true">
                  <path d={socialIconPaths[link.label]} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
