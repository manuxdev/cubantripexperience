---
import { Image } from "@astrojs/image/components";
import mark from "../assets/brand/cuban-trip-experience-mark.webp";
import { primaryNavigation } from "../data/routes";
import { site } from "../data/site";
---

<footer class="mt-section border-t border-black/10 bg-sand">
  <div class="page-container grid gap-8 py-12 md:grid-cols-3">
    <div>
      <Image
        src={mark}
        alt=""
        width={160}
        height={116}
        format="webp"
        class="h-auto w-32"
      />
      <p class="mt-3 text-sm text-ink/70">{site.footerText}</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-sm font-semibold uppercase tracking-wide">Explore</h2>
      <ul class="mt-3 flex flex-col gap-2">
        {
          primaryNavigation.map((item) => (
            <li>
              <a href={item.href} class="text-sm hover:text-gold">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wide">Contact</h2>
      <ul class="mt-3 flex flex-col gap-2 text-sm">
        <li>
          <a href={`mailto:${site.contact.email}`} class="hover:text-gold">
            {site.contact.email}
          </a>
        </li>
        <li>
          <a
            href={`tel:${site.contact.phone.replace(/\s/g, "")}`}
            class="hover:text-gold">
            {site.contact.phone}
          </a>
        </li>
        {
          site.socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="hover:text-gold">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="page-container border-t border-black/10 py-6">
    <p class="text-sm text-ink/60">
      © {new Date().getFullYear()} {site.name}. All rights reserved.
    </p>
  </div>
</footer>
