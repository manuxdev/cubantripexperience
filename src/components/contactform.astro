---
/**
 * Visual-only contact form. The reference form is a Fluent Form; this target
 * reproduces its visible field set without any action, endpoint, hidden service
 * field, submit handler, or network request.
 */
const fields = [
  { id: "contact-name", label: "Name", type: "text", autocomplete: "name" },
  { id: "contact-email", label: "Email", type: "email", autocomplete: "email" },
];
---

<div class="rounded-card border border-black/10 p-6">
  {
    fields.map((field) => (
      <p class="mb-4">
        <label for={field.id} class="block text-sm font-semibold">
          {field.label}
        </label>
        <input
          id={field.id}
          name={field.id}
          type={field.type}
          autocomplete={field.autocomplete}
          class="mt-1 w-full rounded-card border border-black/20 px-3 py-2"
        />
      </p>
    ))
  }
  <p class="mb-4">
    <label for="contact-message" class="block text-sm font-semibold">
      Your Message
    </label>
    <textarea
      id="contact-message"
      name="contact-message"
      rows="5"
      class="mt-1 w-full rounded-card border border-black/20 px-3 py-2"></textarea>
  </p>
  <button
    type="button"
    aria-disabled="true"
    class="w-full rounded-card bg-gold px-6 py-3 font-semibold text-ink">
    Submit
  </button>
</div>
