---
import { Image } from "@astrojs/image/components";
import logo from "../assets/brand/cuban-trip-experience-logo.webp";
import { primaryNavigation } from "../data/routes";
import { site } from "../data/site";

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  currentPath === href || currentPath === href.replace(/\/$/, "");
---

<header class="border-b border-black/10 bg-white">
  <div
    class="page-container flex items-center justify-between gap-4 py-3 md:py-4">
    <a href="/" class="shrink-0" aria-label={`${site.name} — home`}>
      <Image
        src={logo}
        alt={site.name}
        width={140}
        height={118}
        format="webp"
        class="h-12 w-auto md:h-16"
      />
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-6">
        {
          primaryNavigation.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "text-base font-semibold hover:text-gold",
                  isActive(item.href) ? "text-gold" : "text-ink",
                ]}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden md:flex items-center gap-4">
      {
        site.socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener"
            aria-label={link.label}
            class="text-ink hover:text-gold">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true">
              {link.label === "Facebook" ? (
                <path d="M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3" />
              ) : (
                <>
                  <path d="M4 4m0 4a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z" />
                  <path d="M12 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                  <path d="M16.5 7.5l0 .01" />
                </>
              )}
            </svg>
          </a>
        ))
      }
    </div>

    <details class="site-menu md:hidden">
      <summary
        class="list-none cursor-pointer rounded-card border border-black/15 px-3 py-2 text-sm font-semibold"
        aria-label="Toggle navigation menu">
        Menu
      </summary>
      <nav
        aria-label="Primary mobile"
        class="absolute left-0 right-0 z-30 border-b border-black/10 bg-white px-4 py-4 shadow-primary">
        <ul class="flex flex-col gap-3">
          {
            primaryNavigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "block py-1 text-base font-semibold",
                    isActive(item.href) ? "text-gold" : "text-ink",
                  ]}>
                  {item.label}
                </a>
              </li>
            ))
          }
          {
            site.socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener"
                  class="block py-1 text-base font-semibold text-ink">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-menu > summary::-webkit-details-marker {
    display: none;
  }
</style>
