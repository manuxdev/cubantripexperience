# Booking pipeline. Copy to `.env` and fill in; `.env` is gitignored and no
# credential belongs in source. On Vercel these are Environment Variables —
# set all five, or the endpoint answers 500 `config` and files nothing.

# Notion internal integration token, and the database it may write to.
# The integration must be shared with that database from Notion's own UI.
NOTION_TOKEN=
NOTION_DATABASE_ID=f2510634-be85-40d6-8740-d30ec6dbd2ec

# Resend. `BOOKING_FROM` must be an address on a domain VERIFIED in Resend —
# an unverified sender is rejected outright and nobody receives anything.
#
# The only verified domain on this account today is `cubaclassiccartours.com`,
# which is NOT the domain the site runs on. Until `cubantripexperience.com` is
# verified in Resend, the traveller gets a confirmation from a domain they never
# visited: bad for trust, and spam filters read it the same way. Verifying the
# real domain is DNS work in the Resend dashboard, and it is the right fix.
RESEND_API_KEY=
BOOKING_FROM=Cuban Trip Experience <reservas@cubaclassiccartours.com>

# Where the team's copy of every booking lands.
BOOKING_TO=
